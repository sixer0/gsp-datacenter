# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
/services/client-pulse-bot/dist/

# logs & runtime
*.log
hq-dev.*.log
hermes-bridge/bridge.*.log
hermes-bridge/node_modules/

# TLS certs HQ (private key, jangan pernah commit)
/certs/

# runtime bridge
/hermes-bridge/200
/hermes-bridge/db_check*.cjs

# backup files sisa hotfix (F-XP-004)
*.bak-*

# tahanan gerbang NAT-R3 (data runtime, jangan commit)
/hermes-bridge/gate-hold/

# Doc Artifact Studio: artefak run yang dapat dibuat ulang dan sandbox STUDIO_WORKSPACE_ROOT (KT-03).
# Hanya data/studio-workspace/ (bukan data/) karena data/.gitkeep terlacak.
/tests/parity/out/
/benchmark/out/
# Studio test outputs (screenshots, perf runs, logs; D-304)
/tests/perf/out/
/tests/e2e/studio/out/
/tests/integration/studio/out/
/render-env/out/
# Keluaran eksperimen S99 (~9,4 MB): hasil kalibrasi dan set fon yang dibangun ulang oleh
# render-env/semibold-bundle/build_bundle.py (review M9). Berkas tetap di disk.
/render-env/semibold-bundle/out/
/render-env/semibold-bundle/fonts/
/data/studio-workspace/
