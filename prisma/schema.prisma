generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Draft {
  id              String    @id @default(uuid())
  text            String
  title           String?
  model           String?
  status          String    @default("pending")
  type            String?
  category        String?
  hookType        String?
  feedbackRating  String?
  feedbackReason  String?
  viralScore      Json?
  impressionScore Json?
  scheduledDate   String?
  scheduledTime   String?
  visualUrl       String?
  variantGroup    String?
  postedAt        DateTime?
  postedUrl       String?
  tweetUrl        String?
  tweetId         String?
  metrics         Json?
  editHistory     Json?     @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  quoteUrl        String?
  quoteText       String?

  // Content intelligence fields
  source          String?   // "sage" | "organic" | "csv_import"
  engagementScore Float?    // time-weighted composite score (updated by scoring engine)
  engagementTier  String?   // "top20" | "bottom20" | null (cleared/set on rescore)

  @@index([status])
  @@index([createdAt])
  @@index([tweetId])
  @@index([source])
  @@index([engagementTier])
}

model TweetMetric {
  id          String    @id @default(cuid())
  draftId     String
  tweetId     String?
  url         String?
  postedAt    DateTime?
  checkpoints Json?
  createdAt   DateTime  @default(now())

  @@index([draftId])
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  type        String?
  model       String?
  status      String?
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([type])
}

model ContentCalendar {
  id   String @id @default(cuid())
  week String @unique
  data Json
}

model YoutubeIdea {
  id                String   @id @default(cuid())
  title             String
  hook              String?
  angle             String?
  hookType          String?
  funnelStage       String?
  status            String   @default("pending")
  rejectedReason    String?
  sourceUrl         String?
  sourceSummary     String?
  competitionScore  String?  // "gap" | "moderate" | "crowded"
  competitionData   Json?    // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt         DateTime @default(now())

  @@index([status])
}

model YoutubeScript {
  id              String   @id @default(cuid())
  title           String
  hook            String?
  storySetup      String?
  conflict        String?
  insight         String?
  cta             String?
  caption         String?
  onScreenText    String?
  hookType        String?
  funnelStage     String?
  factCheck       Json?
  fullScript      String?
  status          String   @default("draft")
  rejectedReason  String?
  // SEO Package
  seoTitle        String?
  seoDescription  String?
  seoTags         Json?
  seoChapters     Json?
  titleVariants   Json?
  thumbnailConcept String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model YoutubeFeedback {
  id     String   @id @default(cuid())
  title  String
  reason String?
  type   String?
  date   DateTime @default(now())
}

model LongformScript {
  id               String   @id @default(cuid())
  title            String
  type             String?
  status           String   @default("draft")
  platform         String?
  platforms        Json?
  description      String?
  hook             String?
  outline          String?
  fullScript       String?
  targetLength     String?
  factCheck        Json?
  notes            String?
  rejectedReason   String?
  youtubeUrl       String?
  thumbnailUrl     String?
  tweetUrl         String?
  youtubeViews     Int?
  youtubeLikes     Int?
  youtubeComments  Int?
  tweetViews       Int?
  tweetLikes       Int?
  tweetBookmarks   Int?
  tweetRetweets    Int?
  tweetReplies     Int?
  postedAt         DateTime?
  competitionScore String?  // "gap" | "moderate" | "crowded"
  competitionData  Json?    // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt
}

model AgentBusMessage {
  id        String   @id @default(uuid())
  fromAgent String
  toAgent   String
  type      String
  content   String
  metadata  Json?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])
}

// ─── Orchestration Telemetry: jejak interaksi lintas profil (GSP) ────────────
// Satu baris = satu interaksi terarah dari profil/agen A ke profil/agen B.
// Ditulis oleh bridge (dispatch via HQ) dan oleh agen fleet (helper gsp-hq-record),
// dibaca oleh halaman /orchestration (graf + timeline).
model OrchestrationRecord {
  id           String   @id @default(uuid())
  runId        String?                       // pengelompok satu run orkestrasi (opsional)
  fromAgent    String                        // id profil pengirim (mis. gsp-master-controller / brahma)
  toAgent      String                        // id profil penerima
  kind         String   @default("delegate") // delegate | handoff | verify | report | review | gate | dispatch
  status       String   @default("running")  // running | done | blocked | needs-review | failed | rejected
  taskId       String?                       // id task/request (mis. id AgentRequest)
  taskTitle    String?                       // judul tugas singkat
  message      String?                       // catatan singkat / ringkasan hasil
  artifactPath String?                       // path artefak docs/[date]_[task]/... (Documentation Contract)
  meta         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fromAgent])
  @@index([toAgent])
  @@index([status])
  @@index([kind])
  @@index([runId])
  @@index([createdAt])
}

model BattleRoyaleBot {
  id        String   @id
  state     Json
  updatedAt DateTime @updatedAt
}

model ContentRequest {
  id             String    @id @default(uuid())
  prompt         String
  status         String    @default("pending")
  resultDraftIds Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

// ─── Generic Key-Value Store ────────────────────────────────────

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// ─── Daily Briefs ───────────────────────────────────────────────

model Brief {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String   @db.Text
  source    String   @default("brief")
  createdAt DateTime @default(now())
}

// ─── Missions ───────────────────────────────────────────────────

model Mission {
  id          String   @id @default(uuid())
  agentId     String
  title       String
  description String   @db.Text
  status      String   @default("pending") // pending, active, completed, failed
  priority    String   @default("medium") // high, medium, low
  result      String?  @db.Text
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([agentId])
  @@index([status])
}

// ─── Articles ───────────────────────────────────────────────────

model Article {
  id              String    @id @default(uuid())
  title           String
  body            String    @db.Text
  track           String    // "mega-viral" | "local-viral" | "icp-viral"
  status          String    @default("idea") // "idea" | "draft" | "ready" | "posted"
  qtTweet         String?   @db.Text
  qtUrl           String?
  heroImageUrl    String?
  heroImageHtml   String?   @db.Text
  inspirationUrls String?   @db.Text // JSON array of URLs
  themes          String?   // JSON array of themes
  scheduledDate   String?
  postedAt        DateTime?
  postedUrl       String?
  impressions     Int?
  likes           Int?
  bookmarks       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([track])
  @@index([scheduledDate])
}

model SavedTitle {
  id        String   @id @default(cuid())
  title     String
  track     String
  themes    String?  // JSON array
  createdAt DateTime @default(now())

  @@index([track])
}

// ─── Client Pulse Telegram Bot ─────────────────────────────────

model ClientPulseClient {
  id                   String                @id @default(cuid())
  notionPageId         String?               @unique
  clientName           String
  status               String?
  services             Json                  @default("[]")
  productManagerName   String?
  renewalDate          DateTime?
  endDate              DateTime?
  expectedCheckinHours Int                   @default(72)
  sourceUpdatedAt      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  chats                ClientPulseChat[]
  analyses             ClientPulseAnalysis[]
  alerts               ClientPulseAlert[]

  @@index([status])
  @@index([clientName])
  @@index([productManagerName])
}

model ClientPulseChat {
  id              String               @id @default(cuid())
  telegramChatId  String               @unique
  title           String
  linkedClientId  String?
  status          String               @default("active")
  internalUserIds Json                 @default("[]")
  lastSeenAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  linkedClient    ClientPulseClient?   @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)
  messages        ClientPulseMessage[]
  alerts          ClientPulseAlert[]

  @@index([linkedClientId])
  @@index([status])
}

model ClientPulseMessage {
  id                String           @id @default(cuid())
  telegramMessageId String
  telegramChatId    String
  chatId            String?
  senderTelegramId  String
  senderName        String
  isInternal        Boolean          @default(false)
  isBot             Boolean          @default(false)
  text              String           @db.Text
  sentAt            DateTime
  intent            String           @default("other")
  sentiment         String           @default("neutral")
  needsReply        Boolean          @default(false)
  rawJson           Json?
  createdAt         DateTime         @default(now())
  chat              ClientPulseChat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@unique([telegramChatId, telegramMessageId])
  @@index([telegramChatId, sentAt])
  @@index([chatId, sentAt])
  @@index([needsReply])
}

model ClientPulseAnalysis {
  id                  String            @id @default(cuid())
  clientId            String
  windowStart         DateTime
  windowEnd           DateTime
  sentimentScore      Int
  responseScore       Int
  cadenceScore        Int
  renewalRiskScore    Int
  positiveSignalScore Int               @default(70)
  overallScore        Int
  category            String
  reasons             Json              @default("[]")
  evidence            Json              @default("[]")
  recommendedAction   String?           @db.Text
  llmSummary          String?           @db.Text
  analysisSource      String            @default("fallback")
  analyzedAt          DateTime          @default(now())
  client              ClientPulseClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, analyzedAt])
  @@index([category])
  @@index([overallScore])
}

model ClientPulseAlert {
  id                String             @id @default(cuid())
  clientId          String?
  chatId            String?
  type              String
  severity          String
  evidence          Json               @default("[]")
  reason            String             @db.Text
  recommendedAction String?            @db.Text
  sentTo            String?
  sentAt            DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime           @default(now())
  client            ClientPulseClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  chat              ClientPulseChat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([severity])
  @@index([sentAt])
  @@index([acknowledgedAt])
}

// ─── Hermes bus (GSP Agent Headquarter website ↔ Hermes on the Mac mini) ─────
// Shared Postgres is the message bus. A bridge on the mini polls
// AgentRequest, runs approved/safe ones via the `hermes` CLI, and
// mirrors kanban tasks + activity back into HermesTask / AgentEvent.

model AgentRequest {
  id            String    @id @default(cuid())
  origin        String    @default("web")     // "web" | "hermes"
  // FIX 02-09-2026 (temuan #4): inisiator sebenarnya. Username login utk jalur
  // browser ("user:<u>"), id agen utk dispatch antar-profil. Null = belum
  // tercatat (data lama) -> telemetri fallback ke "brahma".
  requestedBy   String?
  kind          String    @default("oneshot") // "oneshot" | "kanban" | "chat" | "instant" (Ask Librarian: hasil langsung done, tanpa review gate)
  title         String
  prompt        String?
  profile       String?                       // target Hermes profile (gsp-*) — null = default/brahma
  sideEffecting Boolean   @default(false)
  status        String    @default("queued")  // queued | awaiting_approval | approved | running | done | failed | rejected
  result        String?
  error         String?
  hermesTaskId  String?
  decidedAt     DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([profile])
}

model AgentEvent {
  id        String   @id @default(cuid())
  kind      String   @default("activity") // activity | run | status | memory
  title     String
  detail    String?
  agent     String?
  level     String   @default("info")     // info | up | warn | down
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model HermesTask {
  id        String   @id                   // Hermes task id
  board     String   @default("default")
  title     String
  assignee  String?
  status    String   @default("todo")
  priority  Int?
  result    String?
  updatedAt DateTime @default(now())
  syncedAt  DateTime @updatedAt

  @@index([board])
  @@index([status])
}

// ─── Hermes Memory Wiki (warm tier — git-tracked markdown, mirrored) ─────
model HermesMemory {
  id         String    @id            // wiki entry slug (relative path w/o .md)
  path       String                   // file path relative to wiki root
  type       String    @default("fact")
  title      String
  status     String    @default("active")
  confidence String?
  provenance String?
  tags       String[]
  links      String[]
  body       String    @default("")
  validFrom  DateTime?
  validTo    DateTime?
  updatedAt  DateTime  @default(now())
  syncedAt   DateTime  @updatedAt

  @@index([type])
  @@index([status])
}

// ILFIX-0927 F1-2 — mirror FTS Information Library (data turunan, dibangun ulang oleh sync F1-3).
// Skema mengikat: docs/2026-09-27-ilfix-ingest/f1/F1-DESIGN.md §3.
// Kolom hasil `tsv tsvector GENERATED STORED` + indeks GIN tsvector/trgm TIDAK bisa diekspresikan
// penuh di Prisma. tsv dipetakan Unsupported("tsvector") (opsi eksplisit F1-DESIGN §3) supaya
// terlihat di skema; ia TIDAK bisa dibaca/ditulis lewat client (dibaca via $queryRaw di F1-4).
// Uji nyata `prisma migrate diff` 27-09 (DB uji ilfix_uji): keluaran drift identik dengan atau
// tanpa pemetaan tsv — Prisma tetap menuntut rebuild indeks dgn nama konvensinya. Sumber
// kebenaran struktur = migration.sql 20260927154000_add_ilsearchdoc. DILARANG `prisma db push`
// terhadap tabel ini (akan menjatuhkan tsv generated + indeks GIN); jalankan perubahan lewat
// migrasi SQL baru.
model IlSearchDoc {
  id        String   @id // wiki: slug HermesMemory; workspace/vault: prefix ws:/vault: + path relatif
  source    String // wiki | workspace | vault
  path      String
  title     String
  body      String   @default("")
  domain    String?
  project   String?
  type      String   @default("note")
  status    String   @default("active")
  rank      Int      @default(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  syncedAt  DateTime @default(now()) @db.Timestamptz(6)
  tsv       Unsupported("tsvector")?
}

// ─── WebUI RBAC users (Brahma WebUI on port 9012) ─────────────────────────
// Mapping user → role → Hermes profile. One Hermes profile per user (cloned
// from the default profile at signup); administrators keep full access and
// are typically bound to the root 'default' profile but may switch freely.
enum Role {
  ADMINISTRATOR
  USER
}

model WebUiUser {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  displayName   String?
  role          Role     @default(USER)
  // W3.1 (F-ARCH-003, 31-08): satu profil Hermes = satu akun. Unique ditegakkan
  // di LEVEL DATABASE (@@unique di bawah), bukan hanya app code. Komentar lama
  // ("admins may share e.g. 'default'") menyesatkan: SEMUA jalur tulis
  // (rbac/route.ts POST, rbac/signup, user-access) sudah menolak duplikat 409
  // dan sensus 31-08 menunjukkan 0 sharing aktual (6 baris, 6 profil).
  hermesProfile String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
  @@unique([hermesProfile])
}

// ─── Doc Artifact Studio (v2.1, S03 contract landing) ─────────────────────
// Spesifikasi: docs/2026-10-22_doc_artifact_studio/masterplan/01_specs.md §1.2-1.3.
// Aditif saja. Tautan misi (missionFolder/agentRequestId/hermesTaskId) sengaja
// tanpa FK ke tabel lama (KD-01). Agregat dokumen Cascade, rujukan lintas
// agregat Restrict (KD-02). Migrasi: 20261022120000_add_studio (D-21: dibuat
// lewat prisma migrate diff dikurangi baseline drift IlSearchDoc, diterapkan
// prisma migrate deploy; DILARANG migrate dev / db push).

enum StudioTier {
  NOTA
  TERBIT
  SERAH
}

enum StudioParamClass {
  B
  K
  T
}

enum StudioReleaseStatus {
  PENDING
  PASS
  FAIL
  NOT_RUN
}

enum StudioOutputFormat {
  DOCX
  PDF
  HTML
  SVG
  PNG
}

enum StudioRenderJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum StudioArtifactKind {
  CHART
  DIAGRAM
  IMAGE
  HTML
}

enum StudioTemplateKind {
  DOCUMENT
  CHART
  DIAGRAM
  IMAGE
  HTML
}

enum StudioSectionGroup {
  DOCUMENT
  PAGE_DEVICE
  CHANNEL
}

enum StudioSectionRegister {
  WRAPPER
  INTERIOR
  NONE
}

enum StudioOutputRole {
  PRIMARY
  FIGURE
}

enum StudioNumberSource {
  AGENT
  SEQUENCE
}

// M01
model StudioTemplate {
  id              String             @id @default(cuid())
  slug            String             @unique // ^[a-z0-9]+(-[a-z0-9]+)*$, maks 64
  name            String
  kind            StudioTemplateKind
  description     String?            @db.Text
  isCanonical     Boolean            @default(false)
  archived        Boolean            @default(false)
  latestVersionNo Int                @default(0)
  createdBy       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  isPreset        Boolean            @default(false) // MX01 (SR-01): preset gaya, hanya ADMIN

  versions  StudioTemplateVersion[]
  documents StudioDocument[]

  @@index([kind])
  @@index([archived])
  @@index([isPreset])
}

// M02
model StudioTemplateVersion {
  id             String   @id @default(cuid())
  templateId     String
  versionNo      Int
  baseVersionId  String?
  overrides      Json
  resolvedParams Json
  paramsSha256   String
  roleFormats    Json
  sectionPlan    Json
  assets         Json
  provenance     Json
  changeNote     String   @db.Text
  createdBy      String
  createdAt      DateTime @default(now())
  skeletonSha256 String? // MX02 (SR-01): null = versi lama, kerangka implisit

  template  StudioTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  base      StudioTemplateVersion?  @relation("TemplateVersionBase", fields: [baseVersionId], references: [id], onDelete: Restrict)
  derived   StudioTemplateVersion[] @relation("TemplateVersionBase")
  revisions StudioRevision[]
  artifacts StudioArtifact[]
  slots     StudioTemplateSlot[]

  @@unique([templateId, versionNo])
  @@index([baseVersionId])
}

// M03 (diisi seed S70, 51 baris)
model StudioSectionType {
  key             String                @id
  catalogId       String                @unique
  group           StudioSectionGroup
  register        StudioSectionRegister
  name            String
  elements        Json
  paramRefs       String[]
  ruleRefs        String[]
  activeTiers     StudioTier[]
  renderable      Boolean
  sourceRef       String
  registryVersion String
  updatedAt       DateTime              @updatedAt

  templateSlots StudioTemplateSlot[] // MX07 (SR-01)
  docSections   StudioDocSection[]

  @@index([group])
}

// M04
model StudioDocument {
  id                String             @id @default(cuid())
  docNumber         String             @unique
  numberSource      StudioNumberSource
  title             String
  typeCode          String
  language          String             @default("ID")
  classification    String
  tier              StudioTier
  templateId        String
  currentRevisionNo Int                @default(1)
  missionFolder     String?
  agentRequestId    String?
  hermesTaskId      String?
  createdBy         String
  archived          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  missionDocKey     String? // MX03 (SR-01): null untuk dokumen v1 (KD-12)
  completeness      StudioCompleteness @default(COMPLETE) // cermin revisi terbaru

  template   StudioTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  revisions  StudioRevision[]
  outputs    StudioOutputFile[]
  renderJobs StudioRenderJob[]
  identities StudioDocIdentity[]

  @@unique([missionFolder, missionDocKey])
  @@index([missionFolder])
  @@index([agentRequestId])
  @@index([hermesTaskId])
  @@index([templateId])
  @@index([createdAt])
}

// M05
model StudioRevision {
  id                String              @id @default(cuid())
  documentId        String
  revisionNo        Int
  parentRevisionNo  Int?
  templateVersionId String
  snapshot          Json
  snapshotSha256    String
  inputSha256       String
  docRev            String
  changeWhat        String              @db.Text
  changeWhy         String              @db.Text
  changeImpact      String              @db.Text
  changedAddresses  String[]
  releaseStatus     StudioReleaseStatus @default(PENDING)
  lintReport        Json?
  createdBy         String
  createdAt         DateTime            @default(now())
  // MX04 (SR-01): schemaId = skema permintaan asal (KD-10); changeScope tata bahasa 03 §9.5
  schemaId           String             @default("studio.doc/v1")
  structureSha256    String?
  completeness       StudioCompleteness @default(COMPLETE)
  completenessReport Json?
  changeScope        String?

  document        StudioDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  templateVersion StudioTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  blocks          StudioBlock[]
  outputs         StudioOutputFile[]
  renderJobs      StudioRenderJob[]
  docSections     StudioDocSection[]
  docChapters     StudioDocChapter[]
  docSubsections  StudioDocSubsection[]
  docBlocks       StudioDocBlock[]

  @@unique([documentId, revisionNo])
  @@index([templateVersionId])
}

// M06
model StudioBlock {
  id            String  @id @default(cuid())
  revisionId    String
  blockId       String
  address       String
  artifactLabel String?
  ordinal       Int
  chapterKey    String
  sectionNo     Int?
  paraNo        Int?
  type          String
  content       Json
  textPlain     String  @db.Text
  contentSha256 String

  revision StudioRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, address])
  @@unique([revisionId, ordinal])
  @@index([revisionId, blockId])
  @@index([revisionId, artifactLabel])
  @@index([revisionId, type])
}

// M07
model StudioArtifact {
  id                String              @id @default(cuid())
  kind              StudioArtifactKind
  schemaId          String
  title             String
  label             String?
  spec              Json
  specSha256        String
  templateVersionId String?
  missionFolder     String?
  agentRequestId    String?
  hermesTaskId      String?
  releaseStatus     StudioReleaseStatus @default(PENDING)
  lintReport        Json?
  createdBy         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  templateVersion StudioTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  outputs         StudioOutputFile[]
  renderJobs      StudioRenderJob[]

  @@index([kind])
  @@index([missionFolder])
  @@index([agentRequestId])
  @@index([createdAt])
}

// M08 (invarian layanan: tepat satu dari revisionId/artifactId terisi)
model StudioOutputFile {
  id          String              @id @default(cuid())
  documentId  String?
  revisionId  String?
  artifactId  String?
  renderJobId String?
  format      StudioOutputFormat
  role        StudioOutputRole
  figureLabel String?
  relPath     String
  fileName    String
  bytes       Int
  sha256      String
  mime        String
  lintVerdict StudioReleaseStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  // MX06 (SR-01): lingkup render; draft = render parsial dokumen INCOMPLETE
  scopeKind   StudioRenderScopeKind @default(DOCUMENT)
  scopeKey    String?
  draft       Boolean               @default(false)

  document  StudioDocument?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision  StudioRevision?  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  artifact  StudioArtifact?  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  renderJob StudioRenderJob? @relation(fields: [renderJobId], references: [id], onDelete: SetNull)

  @@unique([relPath])
  @@index([documentId, revisionId])
  @@index([artifactId])
  @@index([sha256])
}

// M09
model StudioRenderJob {
  id           String                @id @default(cuid())
  documentId   String?
  revisionId   String?
  artifactId   String?
  formats      StudioOutputFormat[]
  status       StudioRenderJobStatus @default(QUEUED)
  errorCode    String?
  errorMessage String?               @db.Text
  engine       Json?
  requestedBy  String
  queuedAt     DateTime              @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  // MX05 (SR-01): scopeKey = kunci bab (CHAPTER), slotKey (SLOT), null (DOCUMENT)
  scopeKind    StudioRenderScopeKind @default(DOCUMENT)
  scopeKey     String?

  document StudioDocument?    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision StudioRevision?    @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  artifact StudioArtifact?    @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  outputs  StudioOutputFile[]

  @@index([status])
  @@index([documentId])
  @@index([artifactId])
  @@index([queuedAt])
}

// WorkerTrace — tabel jejak worker yang sudah ada di DB (diisi proses di luar repo ini;
// tak ada penulis di kode repo) tanpa riwayat migrasi. Model ini hasil introspeksi
// `prisma db pull --print` atas gsp_agent_hq_v21 (INT-K, IP-19, F-003); baseline
// migrasi 20261023150000_worker_trace_baseline ditandai applied (migrate resolve).
// Jangan dihapus (D-21).
model WorkerTrace {
  id         String    @id
  task_id    String
  profile    String?
  started_at DateTime? @db.Timestamp(6)
  ended_at   DateTime? @db.Timestamp(6)
  outcome    String?
  source     String    @default("mirror")

  @@index([task_id])
}

// ---------------------------------------------------------------------------
// Studio struktur per section (SR-01 register, masterplan/03_structural_sections_specs.md §3;
// migrasi 20261023200000_add_studio_structure, SR-03). Penyimpanan per revisi = salinan
// penuh M14-M17 (R6); M18 per dokumen, tidak disalin.
// ---------------------------------------------------------------------------

// E26
enum StudioSlotContentMode {
  AUTO
  INPUT
  MIXED
}

// E27
enum StudioRenderScopeKind {
  DOCUMENT
  CHAPTER
  SLOT
}

// E28
enum StudioCompleteness {
  INCOMPLETE
  COMPLETE
}

// M10 (slot kerangka versi templat)
model StudioTemplateSlot {
  id                String                @id @default(cuid())
  templateVersionId String
  slotKey           String // pola C18
  sectionTypeKey    String
  label             String
  position          Int
  required          Boolean               @default(false)
  positionLocked    Boolean               @default(false)
  repeatable        Boolean               @default(false)
  minItems          Int?
  maxItems          Int?
  contentMode       StudioSlotContentMode
  tiers             StudioTier[] // kosong = semua tier
  admits            String[]
  configSha256      String
  createdAt         DateTime              @default(now())

  templateVersion StudioTemplateVersion          @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  sectionType     StudioSectionType              @relation(fields: [sectionTypeKey], references: [key], onDelete: Restrict)
  params          StudioTemplateSlotParam[]
  roleFormats     StudioTemplateSlotRoleFormat[]
  docSections     StudioDocSection[]

  @@unique([templateVersionId, slotKey])
  @@unique([templateVersionId, position])
  @@index([sectionTypeKey])
}

// M11 (nilai parameter per slot; kelas T ditolak layanan)
model StudioTemplateSlotParam {
  id         String           @id @default(cuid())
  slotId     String
  paramKey   String
  value      Json
  paramClass StudioParamClass
  surface    String // essential | advanced (salinan saat tulis)

  slot StudioTemplateSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, paramKey])
  @@index([paramKey])
}

// M12 (format peran per slot: {para?, run?})
model StudioTemplateSlotRoleFormat {
  id      String @id @default(cuid())
  slotId  String
  roleKey String // E23 RoleKey
  format  Json

  slot StudioTemplateSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, roleKey])
}

// M13 (gambar unggahan, dedupe sha256)
model StudioAsset {
  id            String   @id @default(cuid())
  sha256        String   @unique
  mime          String // image/png | image/jpeg
  bytes         Int
  widthPx       Int
  heightPx      Int
  relPath       String   @unique // C33c
  missionFolder String?
  createdBy     String
  createdAt     DateTime @default(now())

  blocks StudioDocBlock[]

  @@index([missionFolder])
}

// M14 (slot terisi per revisi; templateSlotId null = kerangka implisit)
model StudioDocSection {
  id                   String    @id @default(cuid())
  revisionId           String
  templateSlotId       String?
  slotKey              String
  sectionTypeKey       String
  position             Int // 1..n kontigu
  filled               Boolean
  payload              Json?
  payloadSha256        String
  lastFilledBy         String?
  lastFilledAt         DateTime?
  lastFilledRevisionNo Int?

  revision     StudioRevision      @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  templateSlot StudioTemplateSlot? @relation(fields: [templateSlotId], references: [id], onDelete: Restrict)
  sectionType  StudioSectionType   @relation(fields: [sectionTypeKey], references: [key], onDelete: Restrict)
  chapters     StudioDocChapter[]
  blocks       StudioDocBlock[]

  @@unique([revisionId, slotKey])
  @@unique([revisionId, position])
  @@index([templateSlotId])
}

// M15 (bab slot berulang per revisi; FK identitas NoAction, KD-07)
model StudioDocChapter {
  id                   String    @id @default(cuid())
  revisionId           String
  docSectionId         String
  identityId           String
  chapterKey           String
  position             Int
  partKey              String?
  title                Json // InlineV2
  shortTitle           String?
  contentSha256        String
  lastFilledBy         String?
  lastFilledAt         DateTime?
  lastFilledRevisionNo Int?

  revision    StudioRevision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  docSection  StudioDocSection      @relation(fields: [docSectionId], references: [id], onDelete: Cascade)
  identity    StudioDocIdentity     @relation(fields: [identityId], references: [id], onDelete: NoAction)
  subsections StudioDocSubsection[]
  blocks      StudioDocBlock[]

  @@unique([revisionId, chapterKey])
  @@unique([docSectionId, position])
  @@index([revisionId, contentSha256])
  @@index([identityId])
}

// M16 (subbab; sectionNo 0 = intro bab)
model StudioDocSubsection {
  id            String @id @default(cuid())
  revisionId    String
  chapterId     String
  identityId    String
  sectionNo     Int
  title         Json?
  contentSha256 String

  revision StudioRevision    @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  chapter  StudioDocChapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  identity StudioDocIdentity @relation(fields: [identityId], references: [id], onDelete: NoAction)
  blocks   StudioDocBlock[]

  @@unique([chapterId, sectionNo])
  @@index([identityId])
}

// M17 (blok v2 per revisi; content tanpa id)
model StudioDocBlock {
  id            String  @id @default(cuid())
  revisionId    String
  docSectionId  String
  chapterId     String?
  subsectionId  String?
  identityId    String
  pid           String
  address       String?
  artifactLabel String?
  ordinal       Int
  paraNo        Int?
  type          String
  content       Json
  textPlain     String  @db.Text
  contentSha256 String
  assetId       String?

  revision   StudioRevision       @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  docSection StudioDocSection     @relation(fields: [docSectionId], references: [id], onDelete: Cascade)
  chapter    StudioDocChapter?    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subsection StudioDocSubsection? @relation(fields: [subsectionId], references: [id], onDelete: Cascade)
  identity   StudioDocIdentity    @relation(fields: [identityId], references: [id], onDelete: NoAction)
  asset      StudioAsset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([revisionId, ordinal])
  @@unique([revisionId, pid])
  @@unique([revisionId, address])
  @@index([subsectionId, paraNo])
  @@index([identityId])
  @@index([revisionId, artifactLabel])
  @@index([revisionId, type])
  @@index([assetId])
}

// M18 (identitas pid per dokumen; kind E30: CHAPTER | SUBSECTION | BLOCK)
model StudioDocIdentity {
  id                String   @id @default(cuid())
  documentId        String
  pid               String // pola C19
  kind              String
  createdRevisionNo Int
  retiredRevisionNo Int?
  createdBy         String
  createdAt         DateTime @default(now())

  document    StudioDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapters    StudioDocChapter[]
  subsections StudioDocSubsection[]
  blocks      StudioDocBlock[]

  @@unique([documentId, pid])
  @@index([documentId, kind])
}
