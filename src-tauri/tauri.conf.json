{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GSP Agent Headquarter",
  "version": "0.1.0",
  "identifier": "com.gspagenthq.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:9011",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "GSP Agent Headquarter",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
