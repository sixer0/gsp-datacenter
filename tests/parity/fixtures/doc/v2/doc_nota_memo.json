          "intro": [
            {
              "type": "paragraph",
              "text": "Nota ini disusun Tim Fasilitas untuk pengelola gedung: dua dari tiga pompa memerlukan penggantian segel dalam 30 hari, dengan jangkar terukur getaran 7,1 mm/s.",
              "role": "identity"
            }
          ]
        },
        {
          "key": "2",
          "title": {
            "text": "Pedoman tindak"
          },
          "sections": [
            {
              "title": {
                "text": "Aturan dan pengingat"
              },
              "blocks": [
                {
                  "type": "aside",
                  "variant": "generic",
                  "label": {
                    "text": "Catatan"
                  },
                  "body": [
                    {
                      "text": "Segel mekanis tidak boleh dijalankan kering."
                    }
                  ]
                },
                {
                  "type": "aside",
                  "variant": "doctrine",
                  "label": {
                    "text": "Doktrin"
                  },
                  "body": [
                    {
                      "text": "Ukur dulu, baru ganti; penggantian tanpa ukur ulang tidak dicatat sebagai perbaikan."
                    }
                  ]
                },
                {
                  "type": "aside",
                  "variant": "story",
                  "label": {
                    "text": "Kisah lapangan"
                  },
                  "body": [
                    {
                      "text": "Pompa serupa di gedung lain gagal karena bantalan tidak dilumasi selama setahun."
                    }
                  ]
                },
                {
                  "type": "aside",
                  "variant": "quickCheck",
                  "label": {
                    "text": "Cek cepat"
                  },
                  "body": [
                    {
                      "text": "Getaran di bawah 4,5 mm/s?"
                    },
                    {
                      "text": "Suhu bantalan di bawah 60 C?"
                    }
                  ]
                },
                {
                  "type": "aside",
                  "variant": "ifInDoubt",
                  "label": {
                    "text": "Bila ragu"
                  },
                  "body": [
                    {
                      "text": "Hentikan pompa dan hubungi teknisi jaga."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Rincian prosedur",
                  "role": "subheading"
                },
                {
                  "type": "paragraph",
                  "text": "Prosedur lengkap tersedia di buku perawatan gedung, bagian pompa.",
                  "role": "note"
                },
                {
                  "type": "paragraph",
                  "text": "Mohon pengelola gedung menyetujui penggantian segel P-3 paling lambat 27 Oktober 2026.",
                  "role": "closingAction"
                }
              ]
            }
          ]
